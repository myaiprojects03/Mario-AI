# Database Connection
DATABASE_URL=postgresql://postgres:postgrespassword@db:5432/mario_ai

# External API Credentials
JARBET_API_KEY=your_jarbet_api_key_here
JARBET_BASE_URL=https://data.jarvisbet.com.br
BETSAPI_TOKEN=your_betsapi_token_here

# Telegram Bot & Channel Credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHANNEL_FIFA_GOALS=-100xxxxxxxxxx
TELEGRAM_CHANNEL_FIFA_AH=-100xxxxxxxxxx
TELEGRAM_CHANNEL_FIFA_ML=-100xxxxxxxxxx
TELEGRAM_CHANNEL_EBASKET_ML=-100xxxxxxxxxx
TELEGRAM_CHANNEL_EBASKET_OU=-100xxxxxxxxxx

# Kickoff Window Parameters (Minutes Before Kickoff)
PRIMARY_KICKOFF_MINS_MIN=1.0
PRIMARY_KICKOFF_MINS_MAX=5.0
TARGET_KICKOFF_MINS=3.0

# Staking Protocol Configuration (FIXED vs QUARTER_KELLY)
STAKING_MODE=FIXED
FIXED_STAKE_UNITS=1.0

# Admin Management Dashboard Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword

# Channel Daily Tip Capping Limits
DAILY_LIMIT_FIFA_GOALS_OU=150
DAILY_LIMIT_FIFA_MONEY_LINE=150
DAILY_LIMIT_FIFA_ASIAN_HANDICAP=100
DAILY_LIMIT_EBASKET_MONEY_LINE=150
DAILY_LIMIT_EBASKET_OU=150

# Optional Dedicated Bot Tokens Per Channel (Falls back to TELEGRAM_BOT_TOKEN if blank)
TELEGRAM_BOT_TOKEN_FIFA_GOALS=
TELEGRAM_BOT_TOKEN_FIFA_AH=
TELEGRAM_BOT_TOKEN_FIFA_ML=
TELEGRAM_BOT_TOKEN_EBASKET_ML=
TELEGRAM_BOT_TOKEN_EBASKET_OU=
